<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Production: never back up auth tokens, billing identifiers, or the
    encrypted vault database to Google cloud backup. Fresh installs reprovision
    a random server bearer token on first launch. -->
    <exclude domain="sharedpref" path="edgellm_server_prefs.xml"/>
    <exclude domain="sharedpref" path="edgellm_billing_prefs.xml"/>
    <exclude domain="sharedpref" path="edgellm_theme_prefs.xml"/>
    <exclude domain="database" path="edgellm_database.db"/>
</full-backup-content>
