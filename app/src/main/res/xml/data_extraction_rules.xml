<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Production: auth tokens, billing identifiers, and the encrypted
        vault database must never leave the device via cloud backup. -->
        <exclude domain="sharedpref" path="edgellm_server_prefs.xml"/>
        <exclude domain="sharedpref" path="edgellm_billing_prefs.xml"/>
        <exclude domain="sharedpref" path="edgellm_theme_prefs.xml"/>
        <exclude domain="database" path="edgellm_database.db"/>
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
