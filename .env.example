# Environment variables (all optional for local offline builds).
# Copy to .env and fill only what you need. Never commit .env.
# Local GGUF/MediaPipe/ONNX/TFLite inference works with placeholders.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_PAYMENT_LINK_PRO=YOUR_STRIPE_PAYMENT_LINK_PRO