# Environment variables (all optional for local offline builds).
# Copy to .env and fill only what you need. Never commit .env.
# Local GGUF/MediaPipe/ONNX/TFLite inference works with all values blank.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Payments are not part of the app. Leave blank unless you fork in billing.
STRIPE_PUBLISHABLE_KEY=
STRIPE_PAYMENT_LINK_PRO=
